MONGO_URI=mongodb://127.0.0.1:27017/enrollment-system
PORT=5000
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
USE_MEMORY_DB=false

# Free Gmail SMTP: enable 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=NCST Admissions <your-gmail-address@gmail.com>
EMAIL_OTP_SECRET=replace-with-a-long-random-secret
